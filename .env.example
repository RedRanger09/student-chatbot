# Copy this file to `.env` in the project root and fill in your values.
# Never commit `.env` — it may contain secrets.

# -----------------------------------------------------------------------------
# Embeddings & retrieval
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=indexes
TOP_K=5
SIMILARITY_THRESHOLD=0.35
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_CHARACTERS=6000

# -----------------------------------------------------------------------------
# LLM provider: auto | gemini | lmstudio
# Auto priority: online remote LM Studio → user browser Gemini key →
# optional server Gemini fallback → error.
# -----------------------------------------------------------------------------
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-2.5-flash

# Optional server-side Gemini fallback for Auto/Gemini when the user has no
# browser key. Leave empty for public deployments that should not use a
# shared operator key. End users supply their own key in AI Settings
# (stored only in localStorage as gemini_api_key).
GOOGLE_API_KEY=
GEMINI_ALLOW_SERVER_FALLBACK=true

# -----------------------------------------------------------------------------
# Remote LM Studio (OpenAI-compatible …/v1)
# Prefer LM_STUDIO_ENDPOINT. Legacy alias: LMSTUDIO_BASE_URL.
# No localhost default — set LAN, tunnel, or public HTTPS URL explicitly.
# Examples:
#   http://192.168.1.20:1234/v1
#   https://my-lmstudio.example.com/v1
# -----------------------------------------------------------------------------
LM_STUDIO_ENDPOINT=
LM_STUDIO_MODEL=auto
# Optional bearer for authenticated tunnels / reverse proxies (never exposed to UI)
LM_STUDIO_API_KEY=
LM_STUDIO_TIMEOUT_SECONDS=120
LM_STUDIO_HEALTH_TIMEOUT_SECONDS=8
LM_STUDIO_MAX_RETRIES=2
LM_STUDIO_HEALTH_INTERVAL_SECONDS=30

# Legacy aliases (still supported):
# LMSTUDIO_BASE_URL=
# LMSTUDIO_MODEL=
# LMSTUDIO_API_KEY=

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# -----------------------------------------------------------------------------
# CORS — comma-separated origins for the frontend (Vercel + local Next.js)
# Example production: https://your-app.vercel.app
# When unset, local Next.js origins are allowed for development.
# -----------------------------------------------------------------------------
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# -----------------------------------------------------------------------------
# Conversation memory
# -----------------------------------------------------------------------------
MAX_HISTORY_MESSAGES=8
MEMORY_IDLE_SECONDS=7200

# -----------------------------------------------------------------------------
# Paths & logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
UPLOAD_FOLDER=uploads
SQLITE_DB_PATH=analytics/analytics.db
