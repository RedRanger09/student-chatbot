# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/

# Environment / secrets — never commit real keys
.env
.env.*
!.env.example
!**/.env.example

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Runtime / generated data (keep directory structure via .gitkeep)
logs/*.log
uploads/*
!uploads/.gitkeep
indexes/*
!indexes/.gitkeep
analytics/*.db
analytics/*.sqlite
analytics/*.sqlite3
analytics/llm_runtime.json
!analytics/.gitkeep

# Keep institutional source documents in Git; only ignore OS junk there.
data/knowledge_base/.DS_Store
data/knowledge_base/Thumbs.db

# Packaging / tooling
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.tsbuildinfo

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env
frontend/.env*.local
frontend/tsconfig.tsbuildinfo
